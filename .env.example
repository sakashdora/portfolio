# Groq API Key — required for the AI Chatbot assistant.
# Get your free key at https://console.groq.com
VITE_GROQ_API_KEY="your_groq_api_key_here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-app-url.com"

# Shared Like counter (optional, used by api/likes.ts on Vercel).
# Connecting an Upstash Redis database to the Vercel project adds these automatically
# (Vercel KV style names KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# VITE_LIKES_API=""   # only if the endpoint lives somewhere other than /api/likes
